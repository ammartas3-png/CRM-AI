    },
    {
      "parameters": {
        "jsCode": "const route = $('Route Update').item.json;\nconst item = $input.first();\nconst binary = item.binary || {};\nconst binaryKey = Object.keys(binary)[0];\nif (!binaryKey) {\n  return [{\n    json: {\n      ok: false,\n      chat_id: route.chat_id,\n      message: 'Could not download the file from Telegram. Please try again.'\n    }\n  }];\n}\n\nconst fileKind = route.file_kind || 'xlsx';\nreturn [{\n  json: {\n    ok: true,\n    chat_id: route.chat_id,\n    user_id: route.user_id,\n    file_name: route.file_name,\n    file_kind: fileKind,\n    binary_key: binaryKey\n  },\n  binary: {\n    data: binary[binaryKey]\n  }\n}];"
      },

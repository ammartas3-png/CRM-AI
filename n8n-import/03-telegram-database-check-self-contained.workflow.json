      "id": "telegram-trigger",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [200, 320]
    },
    {
      "parameters": {
        "jsCode": "const update = $input.first().json;\n\nif (update.callback_query) {\n  const cb = update.callback_query;\n  return [{\n    json: {\n      route: 'callback',\n      callback_id: cb.id,\n      callback_data: cb.data,\n      chat_id: cb.message?.chat?.id,\n      user_id: String(cb.from?.id || 'unknown')\n    }\n  }];\n}\n\nconst message = update.message || {};\nconst chatId = message.chat?.id;\nconst userId = String(message.from?.id || 'unknown');\nconst text = message.text || '';\n\nif (typeof text === 'string' && text.startsWith('/start')) {\n  return [{ json: { route: 'start', chat_id: chatId, user_id: userId } }];\n}\n\nif (message.document) {\n  const fileName = message.document.file_name || 'upload.xlsx';\n  const mimeType = message.document.mime_type || '';\n  const lower = fileName.toLowerCase();\n  let fileKind = 'unsupported';\n  if (lower.endsWith('.xlsx') || mimeType.includes('spreadsheetml')) fileKind = 'xlsx';\n  else if (lower.endsWith('.xls') || mimeType.includes('ms-excel')) fileKind = 'xls';\n  else if (lower.endsWith('.csv') || mimeType.includes('csv') || mimeType.includes('text/plain')) fileKind = 'csv';\n\n  return [{\n    json: {\n      route: 'document',\n      chat_id: chatId,\n      user_id: userId,\n      file_id: message.document.file_id,\n      file_name: fileName,\n      mime_type: mimeType,\n      file_kind: fileKind\n    }\n  }];\n}\n\nreturn [{ json: { route: 'other', chat_id: chatId, user_id: userId } }];"
      },

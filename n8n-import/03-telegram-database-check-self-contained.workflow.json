      "id": "extract-xlsx",
      "name": "Extract XLSX",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [2260, 540],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "const route = $('Route Update').item.json;\nconst items = $input.all();\nconst rows = items\n  .map((item) => item.json)\n  .filter((row) => row && typeof row === 'object' && !row.error && Object.keys(row).length > 0);\n\nif (!rows.length) {\n  return [{\n    json: {\n      chat_id: route.chat_id,\n      user_id: route.user_id,\n      file_name: route.file_name,\n      valid: false,\n      message: 'Database check failed: file is empty or could not be parsed as spreadsheet/CSV.',\n      issues: ['Empty or unreadable file'],\n      columns: 0,\n      total_rows: 0,\n      non_empty_rows: 0,\n      duplicate_rows: 0,\n      header: [],\n      csv_rows: []\n    }\n  }];\n}\n\nconst header = Object.keys(rows[0] || {});\nconst dataRows = rows.map((row) => header.map((key) => {\n  const value = row[key];\n  return value === undefined || value === null ? '' : String(value);\n}));\n\nconst nonEmptyRows = dataRows.filter((row) => row.some((cell) => String(cell).trim() !== ''));\nconst unique = new Set(nonEmptyRows.map((row) => JSON.stringify(row)));\nconst duplicateRows = nonEmptyRows.length - unique.size;\nconst emptyHeaderCells = header.filter((h) => !String(h).trim()).length;\n\nconst issues = [];\nif (!header.length) issues.push('Header row is missing.');\nif (emptyHeaderCells) issues.push(`${emptyHeaderCells} empty header cell(s) found.`);\nif (!nonEmptyRows.length) issues.push('No data rows found after header.');\nif (duplicateRows > 0) issues.push(`${duplicateRows} duplicate data row(s) found.`);\n\nconst valid = issues.length === 0;\nconst message = valid\n  ? `Database check completed successfully.\\nRows: ${nonEmptyRows.length}\\nColumns: ${header.length}\\nConverted to CSV.`\n  : `Database check found issues:\\n- ${issues.join('\\n- ')}\\n\\nRows: ${nonEmptyRows.length}\\nColumns: ${header.length}`;\n\nreturn [{\n  json: {\n    chat_id: route.chat_id,\n    user_id: route.user_id,\n    file_name: route.file_name,\n    valid,\n    message,\n    issues,\n    columns: header.length,\n    total_rows: dataRows.length,\n    non_empty_rows: nonEmptyRows.length,\n    duplicate_rows: duplicateRows,\n    header,\n    csv_rows: [header, ...dataRows]\n  }\n}];"
      },
      "id": "validate-rows",
      "name": "Validate Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2500, 360]
    },
    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst csvRows = data.csv_rows || [];\n\nfunction escapeCsv(value) {\n  const text = value === undefined || value === null ? '' : String(value);\n  if (/[\",\\n\\r]/.test(text)) {\n    return `\"${text.replace(/\"/g, '\"\"')}\"`;\n  }\n  return text;\n}\n\nconst csvText = csvRows.map((row) => (row || []).map(escapeCsv).join(',')).join('\\n');\nconst baseName = String(data.file_name || 'database').replace(/\\.[^.]+$/, '');\nconst csvFileName = `${baseName || 'database'}.csv`;\n\nreturn [{\n  json: {\n    chat_id: data.chat_id,\n    user_id: data.user_id,\n    file_name: data.file_name,\n    valid: data.valid,\n    message: data.message,\n    issues: data.issues || [],\n    csv_filename: csvFileName\n  },\n  binary: {\n    data: await this.helpers.prepareBinaryData(Buffer.from(csvText, 'utf8'), csvFileName, 'text/csv')\n  }\n}];"
      },
      "id": "build-csv",
      "name": "Build CSV File",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2720, 360]

    {
      "parameters": {
        "jsCode": "const sd = $getWorkflowStaticData('global');\nconst seed = sd._rulesMsg || $('Route Update').item.json;\nconst rows = $input.all().map(i => i.json).filter(j => j && !j._seed && (j.trigger_phrase || j.Trigger || j['account no'] === undefined));\nconst usable = $input.all().map(i => i.json).filter(j => j && (j.trigger_phrase || j.Trigger));\nif (!usable.length) {\n  return [{ json: { chat_id: seed.chat_id, text: seed.text, is_confirm: seed.is_confirm, trigger_phrase: '', _no_sheet: true } }];\n}\nreturn usable.map(j => ({ json: { ...j, chat_id: seed.chat_id, text: seed.text, is_confirm: seed.is_confirm } }));\n"
      },
      "id": "after-rules-sheet",
      "name": "After Rules Sheet",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1050,
        1300
      ]
    },
    {
      "parameters": {
        "jsCode": "const sd = $getWorkflowStaticData('global');\nconst route = sd._rulesMsg || $('Route Update').item.json;\nconst chatId = route.chat_id;\nconst userText = String(route.text || '').trim();\nconst isConfirm = !!route.is_confirm;\n\nconst sheetRows = $input.all().map(i => i.json).filter(j => j && (j.trigger_phrase || j.Trigger));\nconst active = sheetRows.filter(j => String(j.active ?? j.Active ?? 'true').toLowerCase() !== 'false');\nconst sample = active.slice(0, 60).map(j => {\n  const t = j.trigger_phrase || j.Trigger || '';\n  const s = j.suggested_status || j.Suggested || '';\n  const g = j.keyword_group || j.group || '';\n  const appr = j.human_approved || j.reviewed || '';\n  return `- [${g}] \"${t}\" → ${s}${appr ? ' (approved:'+appr+')' : ''}`;\n}).join('\\n');\n\nconst BRAIN = `You are the CRM Database-check Rules Brain for a Telegram bot.\nSpeak concise Turkish or English matching the user. Be practical, not verbose.\n\nCANONICAL ZERO-TOKEN RULES (source of truth):\n1) currently busy (no real talk) → No Answer 1-5 (NOT Call Again)\n2) invalid mail + phone NA → keep No Answer (mail does not change status)\n3) first-day wrong number → Denied Registration; 2+ days → Wrong Number or Email\n4) Call Again/Recall → wipe to No Answer only after 5 DISTINCT NA days; fewer → keep Call Again/Recall\n5) no money + concrete callback (tmrw/day/date) → Call Again\n6) CRM Potential → Manual Check only\n7) CRM Decline/Duplicate/DNC → Manual Check, never auto-change\n8) Recall + newer concrete callback → Call Again\n9) No Potential subtypes (e.g. no documents) stay Correct unless a callback override wins\n\nGOOGLE SHEET TRIGGERS (sample, may be noisy; ignore unapproved AI rows):\n${sample || '(sheet empty or unavailable)'}\n\nHOW TO ANSWER:\n- If user pastes comments: say which rule fires, expected status, and why.\n- If user wants a change: draft a short proposal with: id, when, when-not, example comment, expected status.\n  End with exactly: \"Reply CONFIRM to save this draft.\"\n- If unclear, ask one short clarifying question.\n- Never invent n8n URLs. Never claim CRM was updated.`;\n\nif (isConfirm) {\n  const prop = sd.pendingProposal;\n  if (!prop) {\n    return [{ json: {\n      chat_id: chatId, branch: 'reply',\n      reply_text: 'No pending draft. Ask me to propose a rule change first, then reply CONFIRM.'\n    }}];\n  }\n  return [{ json: {\n    chat_id: chatId, branch: 'confirm',\n    account_no: prop.id || 'rule_draft', old_status: '',\n    new_status: prop.expected_status || '', validation_result: 'Rule Draft',\n    decision_source: 'rules_brain', matched_keyword: prop.id || '',\n    confidence: 'Human', reason: String(prop.summary || '').slice(0, 500),\n    example_comment: String(prop.example || '').slice(0, 280), type: 'rule_draft',\n    reply_text: `Draft saved to Decision_Memory.\\nNext: implement in vault/golden/Memory Match (or tell Cursor).\\n\\n${String(prop.summary || '').slice(0, 1200)}`\n  }}];\n}\n\nif (!Array.isArray(sd.chatHistory)) sd.chatHistory = [];\nsd.chatHistory.push({ role: 'user', content: userText });\nif (sd.chatHistory.length > 12) sd.chatHistory = sd.chatHistory.slice(-12);\nconst hist = sd.chatHistory.map(h => `${h.role}: ${h.content}`).join('\\n');\n\nreturn [{ json: {\n  chat_id: chatId, branch: 'ai', system_prompt: BRAIN,\n  user_message: `Chat so far:\\n${hist}\\n\\nLatest user message:\\n${userText}`,\n  raw_user: userText\n}}];\n"
      },

      ],
      "credentials": {
        "telegramApi": {
          "id": "q14sD9Geek2ExOku",
          "name": "Telegram account"
        }
      },
      "webhookId": "56e881d2-e2e4-4d5a-b1f6-5a941571c3c1"
    },
    {
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{ $json.chat_id }}",
        "text": "Send /start then tap Database check and upload a CSV/XLSX file.",
        "additionalFields": {
          "appendAttribution": false
        }
      },
      "id": "other",
      "name": "Other Hint",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        940,
        680
      ],
      "credentials": {
        "telegramApi": {
          "id": "q14sD9Geek2ExOku",
          "name": "Telegram account"
        }
      },
      "webhookId": "0f53b218-618f-4ea0-aa37-1be6b7f2c6c6"
    }
  ],

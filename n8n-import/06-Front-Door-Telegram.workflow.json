    {
      "parameters": {
        "jsCode": "const update = $input.first().json;\nconst sd = $getWorkflowStaticData('global');\n\nif (update.callback_query) {\n  const cb = update.callback_query;\n  const data = String(cb.data || '');\n  const chatId = cb.message?.chat?.id;\n\n  if (data.startsWith('v|')) {\n    const parts = data.split('|');\n    const account = parts[1] || '';\n    const code = parts[2] || '';\n    const STATUS = {\n      ca: 'Call Again', na: 'No Answer 1-5', n5: 'No Answer 5 UP', rc: 'Recall',\n      ni: 'No Interest', np: 'No Potential', wn: 'Wrong Number or Email',\n      dr: 'Denied Registration', keep: 'Keep CRM'\n    };\n    const status = STATUS[code] || code;\n    if (!Array.isArray(sd.humanVotes)) sd.humanVotes = [];\n    sd.humanVotes.push({ account, status, code, chat_id: chatId, at: new Date().toISOString() });\n    if (sd.humanVotes.length > 200) sd.humanVotes = sd.humanVotes.slice(-200);\n    return [{ json: {\n      route: 'vote', callback_id: cb.id, callback_data: data, chat_id: chatId,\n      account, status, code, vote_ack: `Saved: ${account} → ${status}`\n    }}];\n  }\n\n  if (data === 'rules_chat') {\n    sd.mode = 'rules';\n    sd.chatHistory = [];\n    return [{ json: { route: 'rules_enter', callback_id: cb.id, callback_data: data, chat_id: chatId } }];\n  }\n\n  if (data === 'rules_exit') {\n    sd.mode = '';\n    sd.chatHistory = [];\n    sd.pendingProposal = null;\n    return [{ json: { route: 'rules_exit', callback_id: cb.id, callback_data: data, chat_id: chatId } }];\n  }\n\n  if (data === 'database_check') sd.mode = '';\n  return [{ json: {\n    route: 'callback', callback_id: cb.id, callback_data: data, chat_id: chatId,\n    user_id: String(cb.from?.id || '')\n  }}];\n}\n\nconst message = update.message || {};\nconst chatId = message.chat?.id;\nconst text = String(message.text || '').trim();\nconst low = text.toLowerCase();\n\nif (text.startsWith('/start') || low === 'menu' || low === '/menu') {\n  sd.mode = '';\n  return [{ json: { route: 'start', chat_id: chatId } }];\n}\n\nif (message.document) {\n  return [{ json: {\n    route: 'document', chat_id: chatId,\n    file_id: message.document.file_id,\n    file_name: message.document.file_name || 'upload.xlsx',\n    mime_type: message.document.mime_type || ''\n  }}];\n}\n\n// Text menu aliases (if buttons still missing)\nif (low === '1' || low === 'database' || low === 'database check' || low === 'db' || low === 'check') {\n  sd.mode = '';\n  return [{ json: { route: 'callback', callback_id: '', callback_data: 'database_check', chat_id: chatId, from_text: true } }];\n}\nif (low === '2' || low === 'rules' || low === 'rules brain' || low === 'brain' || low === 'kural') {\n  sd.mode = 'rules';\n  sd.chatHistory = [];\n  return [{ json: { route: 'rules_enter', callback_id: '', callback_data: 'rules_chat', chat_id: chatId, from_text: true } }];\n}\n\nif (/^\\/(exit|done|menu)$/i.test(text) || /^exit$/i.test(text)) {\n  sd.mode = '';\n  sd.chatHistory = [];\n  sd.pendingProposal = null;\n  return [{ json: { route: 'rules_exit', chat_id: chatId, text } }];\n}\n\nif (sd.mode === 'rules' && text) {\n  return [{ json: { route: 'rules_msg', chat_id: chatId, text, is_confirm: /^confirm$/i.test(text) } }];\n}\n\nreturn [{ json: { route: 'other', chat_id: chatId, text } }];\n"
      },

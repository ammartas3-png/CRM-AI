        "jsCode": "const sd = $getWorkflowStaticData('global');\nconst prep = $('Prepare Brain').item.json;\nconst raw = $input.first().json;\nlet text = '';\ntry {\n  text = raw.choices?.[0]?.message?.content || raw.message?.content || raw.error?.message || JSON.stringify(raw).slice(0, 500);\n} catch (e) { text = 'Brain error: could not parse model response.'; }\ntext = String(text || '').trim() || '(empty reply)';\nif (/reply confirm to save/i.test(text)) {\n  sd.pendingProposal = {\n    id: 'draft_' + Date.now(),\n    summary: text.slice(0, 900),\n    expected_status: (text.match(/Expected status:\\s*(.+)/i) || [,''])[1].trim().slice(0, 80),\n    example: (text.match(/Example[^\\n]*:\\s*(.+)/i) || [,''])[1].trim().slice(0, 200)\n  };\n}\nif (!Array.isArray(sd.chatHistory)) sd.chatHistory = [];\nsd.chatHistory.push({ role: 'assistant', content: text.slice(0, 1000) });\nif (sd.chatHistory.length > 12) sd.chatHistory = sd.chatHistory.slice(-12);\nif (text.length > 3500) text = text.slice(0, 3500) + '\\n…';\nreturn [{ json: { chat_id: prep.chat_id, reply_text: text } }];\n"

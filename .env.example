# Optional: AI Gateway (manual — Cursor Settings → Models → Override OpenAI Base URL)
# Pick ONE gateway and add your key. Only needed if NOT using Cursor subscription.

# OpenRouter (free :free models available)
# OPENROUTER_API_KEY=sk-or-v1-...
# CURSOR_OPENAI_BASE_URL=https://openrouter.ai/api/v1

# Vercel AI Gateway
# AI_GATEWAY_API_KEY=...
# CURSOR_OPENAI_BASE_URL=https://gateway.ai.cloudflare.com/v1/ACCOUNT/GATEWAY/cursor/v1

# LLM Gateway
# LLM_GATEWAY_API_KEY=...
# CURSOR_OPENAI_BASE_URL=https://api.llmgateway.io/v1

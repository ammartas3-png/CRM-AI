TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Live n8n Database-check webhook (Front Door + chunk continuation)
DATABASE_CHECK_WEBHOOK_URL=https://ammartd20.app.n8n.cloud/webhook/Database-check
# Optional: set in n8n cloud env so Chunk Router / Schedule Next Chunk avoid hardcoding
# N8N_WEBHOOK_DATABASE_CHECK=$DATABASE_CHECK_WEBHOOK_URL

APP_BASE_URL=https://your-project-name.vercel.app
TELEGRAM_WEBHOOK_SECRET=
WEBHOOK_SETUP_KEY=

# Zero-token rule engine (local or public host). n8n cloud needs a public URL for shadow mode.
RULE_ENGINE_URL=http://127.0.0.1:8070
CLASSIFY_CACHE_PATH=./data/crm_classify_cache.sqlite
VAULT_RUNS_DIR=./vault/runs

# Optional services (not required for live Telegram path)
SMART_LAYER_URL=http://127.0.0.1:8060
CREWAI_SERVICE_URL=http://localhost:8080
MEMORY_SERVICE_URL=http://localhost:8090
OPENAI_API_KEY=
OPENAI_MODEL_NAME=gpt-4o-mini
MEMORY_STORAGE_PATH=./data/memory.jsonl
